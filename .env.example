# OpenAI-compatible model provider used by Agent Chat and evaluation execution.
# Copy this file to .env, replace the placeholder, and start with:
# uv run --env-file .env scholar-harness api
OPENAI_MODEL=deepseek-flash
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=replace-with-your-deepseek-api-key

